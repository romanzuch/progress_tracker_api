PORT=3000

# Postgres connection (used directly by the app and by drizzle-kit)
DATABASE_URL=postgres://progress_tracker:progress_tracker@localhost:5432/progress_tracker
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# docker-compose Postgres service — should match the credentials/port in DATABASE_URL above
POSTGRES_USER=progress_tracker
POSTGRES_PASSWORD=progress_tracker
POSTGRES_DB=progress_tracker
POSTGRES_PORT=5432

BNET_CLIENT_ID
BNET_CLIENT_SECRET
BNET_REGION
BNET_REDIRECT_URI

SESSION_JWT_SECRET
SESSION_JWT_EXPIRES_IN
TOKEN_ENCRYPTION_KEY
